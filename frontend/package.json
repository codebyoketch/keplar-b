{
  "name": "cairn-trail-mode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "legacy:api": "backend/.venv/bin/uvicorn app:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "legacy:start": "backend/.venv/bin/uvicorn app:app --app-dir backend --host 127.0.0.1 --port 8000",
    "legacy:test:api": "backend/.venv/bin/python -m pytest backend/tests -q",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:terrain": "node scripts/test-terrain.js",
    "test:api": "uv run --project .. pytest ../backend/tests -q",
    "api": "uv run --project .. uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "start:api": "uv run --project .. uvicorn backend.app.main:app --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "6.4.6"
  },
  "packageManager": "pnpm@10.20.0"
}
